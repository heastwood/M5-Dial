# secrets.yaml.example — commit this file, NOT secrets.yaml
#
# To use:
#   cp secrets.yaml.example secrets.yaml
#   Fill in your real values in secrets.yaml
#
# In your ESPHome config, reference values with  !secret <key>
# e.g.  password: !secret wifi_password

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
wifi_ap_password: "YOUR_FALLBACK_AP_PASSWORD"

# ESPHome native API (used instead of MQTT in m5-dial-cync.yaml)
api_encryption_key: "YOUR_32_BYTE_BASE64_KEY"

# OTA updates
ota_password: "YOUR_OTA_PASSWORD"
